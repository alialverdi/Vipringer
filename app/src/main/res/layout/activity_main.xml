<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- روشن / خاموش -->
        <LinearLayout style="@style/Card">
            <Switch
                android:id="@+id/swEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enabled"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/enabled_hint"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- مخاطبین -->
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="@string/vip_title" />
                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:text="@string/empty"
                android:textColor="@color/text_secondary" />
            <LinearLayout
                android:id="@+id/listVip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- تنظیمات -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/settings_title" />
            <TextView
                android:id="@+id/tvVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <SeekBar
                android:id="@+id/seekVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />
            <Switch
                android:id="@+id/swVibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vibrate" />
            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/test" />
        </LinearLayout>

        <!-- دسترسی‌ها -->
        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/status_title" />
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp" />
            <Button
                android:id="@+id/btnPerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/grant_perms" />
            <Button
                android:id="@+id/btnDnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_dnd" />
            <Button
                android:id="@+id/btnBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_battery" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
